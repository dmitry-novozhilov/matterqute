#!/bin/sh
# Бейдж стоимости AI-разработки: llm-tool count-tokens обновляет README.md,
# .llm-tokens.tsv, .llm-tokens-badge.svg (а также .gitattributes и CLAUDE.md),
# хук кладёт их в индекс, чтобы они попали в этот же коммит.
# Включить в клоне: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 0
if command -v llm-tool >/dev/null 2>&1; then
	llm-tool count-tokens >/dev/null 2>&1 || echo "pre-commit: llm-tool count-tokens failed, badge not updated" >&2
	git add -- README.md .llm-tokens.tsv .llm-tokens-badge.svg .gitattributes CLAUDE.md 2>/dev/null
fi
exit 0
